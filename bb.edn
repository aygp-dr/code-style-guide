{:min-bb-version "1.12.0"
 ;; runtime deps + :paths come from deps.edn (the canonical manifest)
 :deps {local/project {:local/root "."}}
 :tasks
 {:requires ([babashka.fs :as fs]
             [clojure.string :as str])
  :init (do (def src-dirs (filterv fs/directory? ["src" "test" "dev"]))
            (defn test-nses []
              (->> (fs/glob "test" "**_test.clj")
                   ;; bb.edn is EDN: no #() or #"" literals
                   (map (fn [p]
                          (-> (str (fs/relativize "test" p))
                              (str/replace ".clj" "")
                              (str/replace "_" "-")
                              (str/replace fs/file-separator ".")
                              symbol)))
                   sort)))

  ;; The tool's own verbs. code-style-guide checks and fixes other people's
  ;; code, so its tasks carry a style: prefix; plain check is the standard
  ;; lint + fmt + test task below.
  ;; -main takes string args; drop the "--" of `bb style:check -- --dir x`
  style:check {:doc "Check files for style violations"
               :task (apply (requiring-resolve 'code-style-guide.core/-main)
                            (remove #{"--"} *command-line-args*))}

  style:fix   {:doc "Auto-fix style violations where possible"
               :task (apply (requiring-resolve 'code-style-guide.core/-main)
                            "--fix" (remove #{"--"} *command-line-args*))}

  test    {:doc "Run the test suite on the JVM (clojure -M:test)"
           :task (apply shell "clojure -M:test" *command-line-args*)}

  test:bb {:doc "Run the same test namespaces under babashka"
           :extra-paths ["test"]
           :task (let [nses (test-nses)]
                   (apply require nses)
                   (let [{:keys [fail error]} (apply clojure.test/run-tests nses)]
                     (when (pos? (+ fail error))
                       (throw (ex-info "bb tests failed" {:fail fail :error error})))))}

  lint    {:doc "Lint with clj-kondo (fails on errors, reports warnings)"
           :task (apply shell "clojure -M:lint --fail-level error --lint" src-dirs)}

  fmt     {:doc "Check formatting with cljfmt"
           :task (apply shell "clojure -M:fmt check" src-dirs)}

  fmt:fix {:doc "Fix formatting with cljfmt"
           :task (apply shell "clojure -M:fmt fix" src-dirs)}

  check   {:doc "lint + fmt + test + test:bb (what CI runs)"
           :depends [lint fmt test test:bb]}}}
